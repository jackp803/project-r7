{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "namespace",
    "strategy_id",
    "strategy_version",
    "strategy_content_hash",
    "release",
    "symbol",
    "capital_ceiling_usdt",
    "risk_per_trade_usdt",
    "max_positions",
    "daily_loss_limit_usdt",
    "aggregate_loss_limit_usdt",
    "permissions",
    "generation",
    "valid_from",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "r7-deployment-envelope-v0.2"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "namespace": {
      "enum": [
        "FIXTURE",
        "LOCAL_RESEARCH"
      ]
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "strategy_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_hash",
        "build_hash",
        "config_hash",
        "capability_hash",
        "provider_profile_hash",
        "risk_policy_hash",
        "namespace",
        "executable_revision",
        "config_generation",
        "risk_generation",
        "runtime_generation",
        "provider_ref",
        "account_ref",
        "release_kind"
      ],
      "properties": {
        "implementation_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "build_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capability_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_profile_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "risk_policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "namespace": {
          "enum": [
            "FIXTURE",
            "LOCAL_RESEARCH"
          ]
        },
        "executable_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "config_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "risk_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "runtime_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "release_kind": {
          "enum": [
            "FIXTURE",
            "SOURCE_QUALIFIED",
            "NATIVE_QUALIFIED"
          ]
        }
      }
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capital_ceiling_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "risk_per_trade_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "max_positions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "daily_loss_limit_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "aggregate_loss_limit_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MANAGE_EXISTING",
          "NEW_EXPOSURE"
        ]
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deployment_envelope_v0_2"
}
