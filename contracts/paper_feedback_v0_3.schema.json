{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "namespace",
    "strategy",
    "source",
    "binding",
    "producer",
    "created_at",
    "observation",
    "assessment",
    "performance_policy",
    "performance",
    "cost_conventions",
    "live",
    "broker_kind",
    "financial_authority",
    "artifact_links",
    "uncertainty",
    "funding"
  ],
  "properties": {
    "schema_version": {
      "const": "r7-paper-feedback-v0.3"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
    },
    "namespace": {
      "const": "LOCAL_RESEARCH"
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "strategy_version",
        "content_hash"
      ],
      "properties": {
        "strategy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "strategy_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_revision",
        "implementation_hash",
        "execution",
        "worktree"
      ],
      "properties": {
        "executable_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution": {
          "const": "LOCAL"
        },
        "worktree": {
          "enum": [
            "CLEAN",
            "DIRTY",
            "UNAVAILABLE"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_hash",
        "risk_policy_hash",
        "paper_policy_hash"
      ],
      "properties": {
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "risk_policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "paper_policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_generation",
        "process_instance_hash"
      ],
      "properties": {
        "process_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "process_instance_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time",
      "pattern": "Z$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "execution",
        "started_at",
        "observed_at",
        "actual_elapsed_seconds",
        "actual_healthy_seconds",
        "simulated_elapsed_seconds",
        "simulated_healthy_seconds",
        "max_observed_gap_seconds",
        "closed_trades"
      ],
      "properties": {
        "mode": {
          "const": "REAL_TIME"
        },
        "execution": {
          "const": "ACTUAL_OWNER"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40,
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40,
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_elapsed_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "actual_healthy_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "simulated_elapsed_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "simulated_healthy_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "max_observed_gap_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "closed_trades": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes",
        "run_revision",
        "assessment_hash"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          }
        },
        "run_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "assessment_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "performance_policy": {
      "enum": [
        "OPT_OUT",
        "OPT_IN"
      ]
    },
    "performance": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "net_pnl_usdt",
            "expectancy_usdt_per_trade",
            "max_drawdown_usdt",
            "profit_factor"
          ],
          "properties": {
            "net_pnl_usdt": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "expectancy_usdt_per_trade": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "max_drawdown_usdt": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "profit_factor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            }
          }
        }
      ]
    },
    "cost_conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slippage",
        "funding_model",
        "account_scope"
      ],
      "properties": {
        "slippage": {
          "const": "IN_FILL_PRICE_NO_ADDITIONAL_DEDUCTION"
        },
        "funding_model": {
          "const": "OKX_PUBLIC_RECORDED_ENTRY_NOTIONAL_V1"
        },
        "account_scope": {
          "const": "ISOLATED_PER_STRATEGY_RUN"
        }
      }
    },
    "live": {
      "const": {
        "status": "NOT_RUN",
        "performance": null
      }
    },
    "broker_kind": {
      "const": "PAPER_ONLY"
    },
    "financial_authority": {
      "const": "NONE"
    },
    "artifact_links": {
      "const": []
    },
    "uncertainty": {
      "const": [
        "PAPER uses an isolated simulated account and does not establish LIVE performance or financial authority.",
        "Accelerated fixture duration is not actual forward observation.",
        "Closed-trade counts are not independent observations."
      ]
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "funding_model",
        "source_kind",
        "cost_basis",
        "billing_disclosure",
        "status",
        "pending_allocations",
        "finalized_allocations",
        "pending_since",
        "wall_wait_seconds",
        "observed_wait_seconds",
        "wait_reason",
        "flat_observation",
        "latest_source",
        "opportunities"
      ],
      "properties": {
        "funding_model": {
          "const": "OKX_PUBLIC_RECORDED_ENTRY_NOTIONAL_V1"
        },
        "source_kind": {
          "const": "PAPER_MODEL"
        },
        "cost_basis": {
          "const": "ACTUAL_ENTRY_FILL_NOTIONAL"
        },
        "billing_disclosure": {
          "const": "PAPER_MODEL_NOT_EXCHANGE_ACCOUNT_BILL"
        },
        "status": {
          "enum": [
            "FUNDING_PENDING",
            "FINALIZED",
            "NO_FINANCIAL_SAMPLE"
          ]
        },
        "pending_allocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "finalized_allocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "pending_since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "wall_wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "observed_wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "wait_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "flat_observation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "position_id",
                "symbol",
                "actual_quantity",
                "broker_state_observed_at"
              ],
              "properties": {
                "position_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
                },
                "symbol": {
                  "const": "BTC_USDT_PERP"
                },
                "actual_quantity": {
                  "type": "string",
                  "pattern": "^-?0(?:\\.0+)?$"
                },
                "broker_state_observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        },
        "latest_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_code",
            "observed_at",
            "coverage_start",
            "complete_through",
            "snapshot_hash"
          ],
          "properties": {
            "status": {
              "enum": [
                "HEALTHY",
                "UNAVAILABLE"
              ]
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "coverage_start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "complete_through": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "snapshot_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "HEALTHY"
                  }
                }
              },
              "then": {
                "properties": {
                  "observed_at": {
                    "type": "string"
                  },
                  "coverage_start": {
                    "type": "string"
                  },
                  "complete_through": {
                    "type": "string"
                  },
                  "snapshot_hash": {
                    "type": "string"
                  },
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason_code": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "opportunities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluated_boundaries",
            "valid_blocked",
            "non_directional",
            "other_gate_blocked",
            "unresolved_financial",
            "stale_or_invalid",
            "last_boundary"
          ],
          "properties": {
            "evaluated_boundaries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "valid_blocked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "non_directional": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "other_gate_blocked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "unresolved_financial": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "stale_or_invalid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "last_boundary": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "FUNDING_PENDING"
              }
            }
          },
          "then": {
            "properties": {
              "pending_allocations": {
                "const": 1
              },
              "pending_since": {
                "type": "string"
              },
              "wait_reason": {
                "type": "string"
              },
              "flat_observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position_id",
                  "symbol",
                  "actual_quantity",
                  "broker_state_observed_at"
                ],
                "properties": {
                  "position_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
                  },
                  "symbol": {
                    "const": "BTC_USDT_PERP"
                  },
                  "actual_quantity": {
                    "type": "string",
                    "pattern": "^-?0(?:\\.0+)?$"
                  },
                  "broker_state_observed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "pending_allocations": {
                "const": 0
              },
              "pending_since": {
                "type": "null"
              },
              "wait_reason": {
                "type": "null"
              },
              "flat_observation": {
                "type": "null"
              },
              "wall_wait_seconds": {
                "const": 0
              },
              "observed_wait_seconds": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-r7.local/contracts/paper_feedback_v0_3.schema.json",
  "title": "R7 owner-derived recorded-funding PAPER feedback v0.3",
  "$comment": "Structural public projection only. Current owner, generation, exact financial graph and comparative time/healthy-duration checks require the runtime validator; schema validation never supplies authority.",
  "allOf": [
    {
      "if": {
        "properties": {
          "namespace": {
            "const": "FIXTURE"
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "properties": {
              "mode": {
                "const": "ACCELERATED_FIXTURE"
              },
              "execution": {
                "const": "SIMULATED_MECHANICS"
              },
              "actual_elapsed_seconds": {
                "const": 0
              },
              "actual_healthy_seconds": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "namespace": {
            "const": "LOCAL_RESEARCH"
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "properties": {
              "mode": {
                "const": "REAL_TIME"
              },
              "execution": {
                "const": "ACTUAL_OWNER"
              },
              "simulated_elapsed_seconds": {
                "const": 0
              },
              "simulated_healthy_seconds": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "performance_policy": {
            "const": "OPT_OUT"
          }
        }
      },
      "then": {
        "properties": {
          "performance": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation": {
            "properties": {
              "closed_trades": {
                "const": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "performance": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation": {
            "properties": {
              "started_at": {
                "type": "null"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "properties": {
              "observed_at": {
                "type": "null"
              },
              "actual_elapsed_seconds": {
                "const": 0
              },
              "actual_healthy_seconds": {
                "const": 0
              },
              "simulated_elapsed_seconds": {
                "const": 0
              },
              "simulated_healthy_seconds": {
                "const": 0
              },
              "max_observed_gap_seconds": {
                "const": 0
              },
              "closed_trades": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "funding": {
            "properties": {
              "status": {
                "const": "FUNDING_PENDING"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "status": {
                "enum": [
                  "BLOCKED",
                  "FAIL"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
