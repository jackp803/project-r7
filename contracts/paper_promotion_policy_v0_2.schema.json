{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "namespace",
    "generation",
    "validation_policy_version",
    "min_elapsed_seconds",
    "min_closed_trades",
    "min_net_pnl_usdt",
    "min_expectancy_usdt_per_trade",
    "max_drawdown_usdt",
    "max_consecutive_losses",
    "min_profit_factor",
    "profit_factor_null_handling",
    "required_healthy_seconds",
    "maximum_observation_gap_seconds",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": "r7-paper-promotion-policy-v0.2"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "namespace": {
      "enum": [
        "FIXTURE",
        "LOCAL_RESEARCH"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "validation_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "min_elapsed_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "min_closed_trades": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "min_net_pnl_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "min_expectancy_usdt_per_trade": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "max_drawdown_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "max_consecutive_losses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "min_profit_factor": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "profit_factor_null_handling": {
      "enum": [
        "BLOCK",
        "ALLOW_NO_LOSSES"
      ]
    },
    "required_healthy_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "maximum_observation_gap_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "trade_count",
        "pnl",
        "expectancy",
        "drawdown"
      ],
      "properties": {
        "time": {
          "const": "SECONDS"
        },
        "trade_count": {
          "const": "CLOSED_TRADES"
        },
        "pnl": {
          "const": "USDT_AMOUNT"
        },
        "expectancy": {
          "const": "USDT_PER_CLOSED_TRADE"
        },
        "drawdown": {
          "const": "USDT_AMOUNT"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper_promotion_policy_v0_2"
}
