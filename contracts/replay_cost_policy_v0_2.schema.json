{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r7.local/contracts/replay_cost_policy_v0_2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "r7-replay-cost-policy-v0.2"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "namespace": {
      "enum": [
        "FIXTURE",
        "LOCAL_RESEARCH"
      ]
    },
    "cost_model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fixed_quantity": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "quantity_unit": {
      "const": "BASE"
    },
    "fee_unit": {
      "const": "BPS_OF_NOTIONAL"
    },
    "maker_bps": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "taker_bps": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "slippage_unit": {
      "const": "BPS_OF_REFERENCE_PRICE"
    },
    "entry_bps": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "exit_bps": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "max_evaluations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "generation",
    "namespace",
    "cost_model_version",
    "fixed_quantity",
    "quantity_unit",
    "fee_unit",
    "maker_bps",
    "taker_bps",
    "slippage_unit",
    "entry_bps",
    "exit_bps",
    "max_evaluations"
  ],
  "additionalProperties": false
}
