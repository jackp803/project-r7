{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r7.local/contracts/research_policy_v0_2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "r7-research-policy-v0.2"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "namespace": {
      "enum": [
        "FIXTURE",
        "LOCAL_RESEARCH"
      ]
    },
    "validation_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "minimum_closed_trades": {
      "type": "object",
      "properties": {
        "development": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "walk_forward": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "sealed_oos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      },
      "required": [
        "development",
        "walk_forward",
        "sealed_oos"
      ],
      "additionalProperties": false
    },
    "min_net_pnl_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "min_expectancy_usdt_per_trade": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "drawdown_limit": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "drawdown_unit": {
      "enum": [
        "USDT_AMOUNT",
        "FRACTION_OF_INITIAL_EQUITY"
      ]
    },
    "initial_equity_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "max_consecutive_losses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200000
    },
    "min_profit_factor": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "profit_factor_null_handling": {
      "enum": [
        "BLOCK",
        "ALLOW_NO_LOSSES"
      ]
    },
    "split_policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cost_policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "generation",
    "namespace",
    "validation_policy_version",
    "minimum_closed_trades",
    "min_net_pnl_usdt",
    "min_expectancy_usdt_per_trade",
    "drawdown_limit",
    "drawdown_unit",
    "initial_equity_usdt",
    "max_consecutive_losses",
    "min_profit_factor",
    "profit_factor_null_handling",
    "split_policy_hash",
    "cost_policy_hash"
  ],
  "additionalProperties": false
}
