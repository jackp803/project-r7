{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r7.local/contracts/robustness_policy_v0_2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "r7-robustness-policy-v0.2"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "namespace": {
      "enum": [
        "FIXTURE",
        "LOCAL_RESEARCH"
      ]
    },
    "algorithm_version": {
      "const": "r7-robustness-v1"
    },
    "split_policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cost_policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "neighborhood": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "type": {
                "const": "INTEGER"
              },
              "minimum": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "maximum": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "minItems": 1,
                "maxItems": 32
              }
            },
            "required": [
              "parameter",
              "type",
              "minimum",
              "maximum",
              "values"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "type": {
                "const": "DECIMAL"
              },
              "minimum": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              },
              "maximum": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                },
                "minItems": 1,
                "maxItems": 32
              }
            },
            "required": [
              "parameter",
              "type",
              "minimum",
              "maximum",
              "values"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "maximum_trials": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "maximum_replays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "maximum_evaluations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000
    },
    "selection_procedure": {
      "const": "TRAIN_NET_PNL_THEN_VARIANT_HASH_V1"
    },
    "minimum_neighborhood_pass_fraction": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "minimum_walk_forward_pass_fraction": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "minimum_stress_net_pnl_usdt": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "walk_forward_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "training": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
              },
              "end": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "evaluation": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
              },
              "end": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "training",
          "evaluation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "stress_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "fee_add_bps": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
          },
          "entry_slippage_add_bps": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
          },
          "exit_slippage_add_bps": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
          },
          "funding_adverse_multiplier": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
          }
        },
        "required": [
          "name",
          "fee_add_bps",
          "entry_slippage_add_bps",
          "exit_slippage_add_bps",
          "funding_adverse_multiplier"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "monte_carlo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "r7-monte-carlo-policy-v0.2"
          },
          "algorithm": {
            "enum": [
              "TRADE_PERMUTATION",
              "MOVING_BLOCK_BOOTSTRAP"
            ]
          },
          "algorithm_version": {
            "const": "r7-mc-v1"
          },
          "rng_algorithm": {
            "const": "SHA256_COUNTER_REJECTION_V1"
          },
          "resample_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "minimum_samples": {
            "type": "integer",
            "minimum": 2,
            "maximum": 200000
          },
          "minimum_effective_blocks": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10000
          },
          "block_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "sample_source": {
            "const": "CLOSED_DEVELOPMENT_TRADE_NET_PNL_USDT"
          },
          "initial_equity": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
          },
          "drawdown_unit": {
            "enum": [
              "USDT_AMOUNT",
              "FRACTION_OF_INITIAL_EQUITY"
            ]
          },
          "max_path_observations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500000
          },
          "dependence_model": {
            "enum": [
              "ORDER_SENSITIVITY",
              "OVERLAPPING_FIXED_BLOCKS"
            ]
          }
        },
        "required": [
          "schema_version",
          "algorithm",
          "algorithm_version",
          "rng_algorithm",
          "resample_count",
          "minimum_samples",
          "minimum_effective_blocks",
          "block_length",
          "sample_source",
          "initial_equity",
          "drawdown_unit",
          "max_path_observations",
          "dependence_model"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "max_monte_carlo_drawdown_q95": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "minimum_block_expectancy_q05_usdt_per_trade": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "generation",
    "namespace",
    "algorithm_version",
    "split_policy_hash",
    "cost_policy_hash",
    "neighborhood",
    "maximum_trials",
    "maximum_replays",
    "maximum_evaluations",
    "selection_procedure",
    "minimum_neighborhood_pass_fraction",
    "minimum_walk_forward_pass_fraction",
    "minimum_stress_net_pnl_usdt",
    "walk_forward_windows",
    "stress_scenarios",
    "monte_carlo",
    "max_monte_carlo_drawdown_q95",
    "minimum_block_expectancy_q05_usdt_per_trade"
  ],
  "additionalProperties": false
}
