{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "generation",
    "units",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "r7-selected-risk-policy-v0.2"
    },
    "namespace": {
      "enum": [
        "FIXTURE",
        "LOCAL_RESEARCH"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "margin",
        "notional",
        "estimated_cost",
        "drawdown",
        "leverage",
        "reward_risk",
        "time"
      ],
      "properties": {
        "margin": {
          "const": "USDT_AMOUNT"
        },
        "notional": {
          "const": "USDT_AMOUNT"
        },
        "estimated_cost": {
          "const": "USDT_AMOUNT"
        },
        "drawdown": {
          "const": "USDT_AMOUNT"
        },
        "leverage": {
          "const": "RATIO"
        },
        "reward_risk": {
          "const": "RATIO"
        },
        "time": {
          "const": "SECONDS"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "max_margin",
        "max_notional",
        "max_leverage",
        "min_reward_risk",
        "max_estimated_cost",
        "max_trades_per_day",
        "max_open_positions",
        "max_drawdown",
        "max_consecutive_losses",
        "max_intent_age_seconds",
        "max_hold_seconds",
        "plan_ttl_seconds",
        "margin_mode"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "max_margin": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "max_notional": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "max_leverage": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "min_reward_risk": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "max_estimated_cost": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "max_trades_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_open_positions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_drawdown": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "max_consecutive_losses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_intent_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_hold_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "plan_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "margin_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selected_risk_policy_v0_2"
}
