{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r7.local/contracts/split_policy_v0_2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "r7-split-policy-v0.2"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "namespace": {
      "enum": [
        "FIXTURE",
        "LOCAL_RESEARCH"
      ]
    },
    "training": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "development": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "sealed_oos": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "warmup_bars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_holding_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "label_horizon_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "embargo_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "embargo_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "generation",
    "namespace",
    "training",
    "development",
    "sealed_oos",
    "warmup_bars",
    "max_holding_seconds",
    "label_horizon_seconds",
    "embargo_seconds",
    "embargo_rationale"
  ],
  "additionalProperties": false
}
