{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client", "node"], "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts"]
}
